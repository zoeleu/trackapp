# ── Cloudflare Turnstile ──────────────────────────────────────────────────
# Site key (public — exposed to the client)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x000000000000000000
# Secret key (server-only — never exposed)
TURNSTILE_SECRET_KEY=0x000000000000000000

# ── External auth service ─────────────────────────────────────────────────
# GET this URL to obtain a JWT. Response: { access_token, expires_in }
EXTERNAL_AUTH_URL=https://sinclog-public-tracking-bff.luizalabs.com/v1/auth/token

# ── External tracking API ─────────────────────────────────────────────────
# Base URL of the tracking service. Requests go to:
#   ${EXTERNAL_TRACKING_API_URL}/tracking/<number>
EXTERNAL_TRACKING_API_URL=https://sinclog-public-tracking-bff.luizalabs.com/v1
# Optional — browser headers the upstream API expects (defaults shown)
# TRACKING_REFERER=https://cademinhaentrega.com.br/
# TRACKING_CARRIER=201801
